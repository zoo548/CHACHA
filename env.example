# 시연 방송. 이 파일을 복사해 .env.local 로 쓰거나 Vercel 대시보드에 넣는다.
# 재난문자 API 키·개인정보는 넣지 않는다.

# Vercel Marketplace Upstash Redis 연동 시 자동으로 들어간다.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# 발표자 페이지 비밀번호. 코드에 넣지 말 것.
DEMO_PRESENTER_KEY=

# 네이티브 앱이 Vercel API 를 부를 때만. 웹(같은 주소)은 비워 둔다.
# VITE_DEMO_URL=https://your-app.vercel.app
