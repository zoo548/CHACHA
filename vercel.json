{
  "framework": "vite",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "installCommand": "pnpm install --frozen-lockfile --ignore-scripts",
  "env": {
    "VITE_DEMO_DEFAULT": "true"
  },
  "functions": {
    "api/current.ts": { "maxDuration": 10 },
    "api/count.ts": { "maxDuration": 10 },
    "api/join.ts": { "maxDuration": 10 },
    "api/send.ts": { "maxDuration": 10 },
    "api/reset.ts": { "maxDuration": 10 }
  },
  "rewrites": [
    { "source": "/api/demo/current", "destination": "/api/current" },
    { "source": "/api/demo/count", "destination": "/api/count" },
    { "source": "/api/demo/join", "destination": "/api/join" },
    { "source": "/api/demo/send", "destination": "/api/send" },
    { "source": "/api/demo/reset", "destination": "/api/reset" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, max-age=0" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, max-age=0" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, max-age=0" }
      ]
    }
  ]
}
