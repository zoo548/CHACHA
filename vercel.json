{
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "installCommand": "pnpm install --frozen-lockfile --ignore-scripts",
  "env": {
    "VITE_DEMO_DEFAULT": "true"
  },
  "functions": {
    "api/index.js": {
      "excludeFiles": "{android,ios,server,docs,dist}/**"
    }
  },
  "rewrites": [
    { "source": "/api/demo/current", "destination": "/api?op=current" },
    { "source": "/api/demo/count", "destination": "/api?op=count" },
    { "source": "/api/demo/join", "destination": "/api?op=join" },
    { "source": "/api/demo/send", "destination": "/api?op=send" },
    { "source": "/api/demo/reset", "destination": "/api?op=reset" },
    { "source": "/api/current", "destination": "/api?op=current" },
    { "source": "/api/count", "destination": "/api?op=count" },
    { "source": "/api/join", "destination": "/api?op=join" },
    { "source": "/api/send", "destination": "/api?op=send" },
    { "source": "/api/reset", "destination": "/api?op=reset" },
    { "source": "/((?!api(?:/|$)).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, max-age=0" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, max-age=0" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, max-age=0" }
      ]
    }
  ]
}
